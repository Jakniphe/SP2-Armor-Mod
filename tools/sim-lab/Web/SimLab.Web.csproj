<Project Sdk="Microsoft.NET.Sdk">
  <!-- The console host: starts the lab and opens the page in the browser (any system). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SimLab</AssemblyName>
    <RootNamespace>SimLab.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/SimLab.Core.csproj" />
  </ItemGroup>
</Project>
