<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The checker itself: a small Roslyn program (see Program.cs and README.md). It is NOT the mod; the mod is never built
    by it. It reads the mod's sources and the decompiled game's sources, and reports the compile errors that fall in the mod.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CompileCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <!-- Reference DLLs for the mod's code (Unity's API and Harmony); never run. -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
</Project>
